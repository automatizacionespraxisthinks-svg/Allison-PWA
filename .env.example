# =====================================================================
#  Allison — variables de entorno
#
#  Copia este archivo como .env y llena los valores.
#  NUNCA subas .env a git: ya está en .gitignore.
#
#  Aquí SOLO están las variables que el código lee de verdad. Si
#  agregas una al código, agrégala aquí; si dejas de usarla, quítala.
# =====================================================================

# --- Base de datos (obligatoria) --------------------------------------
# Postgres. Si la URL lleva sslmode=disable, la conexión va SIN cifrar
# (solo aceptable si el servidor no tiene TLS y sabes lo que implica).
DATABASE_URL=

# Opcional: para correr migraciones contra producción desde tu máquina.
DATABASE_URL_PRODUCCION=

# --- Sesiones (obligatorias) ------------------------------------------
# Secreto largo y aleatorio. En Windows PowerShell:
#   [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
# Cambiarlo cierra todas las sesiones abiertas.
AUTH_SECRET=
# La dirección pública, sin barra final. En producción DEBE ser https:
# de ahí sale la marca de cookie segura.
AUTH_URL=http://localhost:3000

# --- Gemini (obligatoria) ---------------------------------------------
# aistudio.google.com > Get API key. Ponle límite de gasto mensual.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Correo (obligatorio) ---------------------------------------------
# consola = lo imprime en la terminal (solo desarrollo)
# gmail   = lo envía por SMTP con contraseña de aplicación
# resend  = lo envía por la API de Resend (necesita dominio propio)
# En producción, 'consola' revienta a propósito.
CORREO=consola

# Para CORREO=gmail — la contraseña de APLICACIÓN, no la normal:
# myaccount.google.com > Seguridad > Contraseñas de aplicaciones
GMAIL_USUARIO=
GMAIL_APP_PASSWORD=

# Para CORREO=resend (solo con dominio verificado):
RESEND_API_KEY=
CORREO_REMITENTE=

# --- Pagos (obligatorio) ----------------------------------------------
# simulada = aprueba sin dinero real (solo desarrollo; revienta en
# producción) · wompi = cobros de verdad
PASARELA=simulada

# Solo para la simulada: firma sus avisos de prueba.
PASARELA_SECRETO=

# Solo para PASARELA=wompi. LAS TRES O NINGUNA: si falta la de eventos,
# Wompi cobra y la app rechaza el aviso — el alumno paga y no recibe.
# Wompi > Desarrolladores. (La llave PRIVADA no se usa: el checkout
# alojado no la pide.)
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# --- Tarea de limpieza diaria -----------------------------------------
# Borra conversaciones de más de 20 días, enlaces vencidos y órdenes
# abandonadas. La ruta acepta cualquiera de los dos secretos.
#   CRON_SECRET     lo manda Vercel solo a su cron programado
#   TAREAS_SECRETO  para llamarla desde n8n o a mano
CRON_SECRET=
TAREAS_SECRETO=

# --- Detrás de un proxy -----------------------------------------------
# cloudflare | reverso | (vacío si no hay proxy delante)
# Vacío detrás de un proxy = TODOS los usuarios comparten un mismo cubo
# de límite, y un solo abusador deja sin registrarse al resto.
PROXY_CONFIABLE=

# --- Reglas de negocio ------------------------------------------------
COP_POR_MENSAJE=60
RECARGA_MINIMA_COP=4000
MENSAJES_PRUEBA_INICIAL=5
MENSAJES_PRUEBA_VERIFICAR=15
REGISTROS_GLOBALES_POR_HORA=60

# --- Solo para el script de siembra de colegios -----------------------
MENSAJES_PRUEBA_GRATIS=20

# --- Entrar con Google (opcional, HOY DESACTIVADO) --------------------
# Sin estas dos, el botón de Google no aparece — que es lo correcto por
# ahora: el alta con Google marca los consentimientos legales sin
# preguntárselos al usuario. No las definas hasta arreglar eso.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# =====================================================================
#  Variables que YA NO existen (si las ves en algún sitio, bórralas:
#  ningún archivo las lee y solo estorban):
#
#  AUDIO_MAX_SEGUNDOS ............ es una constante del código
#  DIAS_RETENCION_CONVERSACIONES . el plazo vive en la base
#  AVISO_MENSAJES_RESTANTES ...... nunca se implementó
#  REDIS_URL ..................... no hay Redis
#  TTS_URL / TTS_API_KEY / TTS_VOZ  la voz es la del navegador
#  R2_* (cinco) .................. no se guardan audios
#  WOMPI_PRIVATE_KEY ............. el checkout alojado no la pide
# =====================================================================
