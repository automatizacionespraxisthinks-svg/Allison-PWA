# =====================================================================
#  Allison — variables de entorno
#
#  Copia este archivo como .env y llena los valores.
#  NUNCA subas el archivo .env a Git. Ya está en .gitignore.
# =====================================================================

# --- Base de datos -----------------------------------------------------
# En desarrollo: la cadena que entrega el proveedor de Postgres en la nube.
# En producción (Vercel): la cadena del POOLER de Neon — el host con "-pooler" —,
# nunca la directa: cada función abre sus conexiones y la directa se agota.
DATABASE_URL=

# --- Autenticación -----------------------------------------------------
# Genera un secreto largo y aleatorio. En Windows PowerShell:
#   [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google (para "Entrar con Google")
# Se sacan en console.cloud.google.com > Credenciales > ID de cliente OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Gemini ------------------------------------------------------------
# aistudio.google.com > Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Servicio de voz (TTS en el VPS) -----------------------------------
# En desarrollo apunta al servidor que ya tienes corriendo.
TTS_URL=
TTS_API_KEY=
TTS_VOZ=

# --- Almacenamiento de audios (Cloudflare R2) --------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=allison-audios
R2_PUBLIC_URL=

# --- Pasarela de pago --------------------------------------------------
# simulada (desarrollo) o wompi (cuando lleguen las llaves)
PASARELA=simulada
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
# Secreto de integridad (Wompi > Desarrolladores): firma cada checkout
WOMPI_INTEGRITY_SECRET=

# --- Redis (cola) ------------------------------------------------------
# Vacío en desarrollo: la cola corre en memoria.
REDIS_URL=

# --- Reglas de negocio -------------------------------------------------
COP_POR_MENSAJE=60
RECARGA_MINIMA_COP=4000
MENSAJES_PRUEBA_GRATIS=20
AUDIO_MAX_SEGUNDOS=60
DIAS_RETENCION_CONVERSACIONES=20
AVISO_MENSAJES_RESTANTES=10

# Secreto para firmar los avisos de la pasarela simulada
PASARELA_SECRETO=

# Reparto de la prueba gratuita
MENSAJES_PRUEBA_INICIAL=5
MENSAJES_PRUEBA_VERIFICAR=15

# consola (desarrollo) o resend (cuando haya proveedor)
CORREO=consola
RESEND_API_KEY=
CORREO_REMITENTE=

# Secreto para las tareas programadas que llama n8n (opcional si usas el cron de Vercel)
TAREAS_SECRETO=

# Secreto del cron de Vercel: Vercel lo manda solo como Bearer al cron de limpieza
CRON_SECRET=

# cloudflare | reverso | (vacio si no hay proxy delante)
PROXY_CONFIABLE=
REGISTROS_GLOBALES_POR_HORA=60
