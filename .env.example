# =====================================================================
#  Allison — variables de entorno
#
#  Copia este archivo como .env y llena los valores.
#  NUNCA subas .env a git: ya está en .gitignore.
#
#  Aquí SOLO están las variables que el código lee de verdad. Si
#  agregas una al código, agrégala aquí; si dejas de usarla, quítala.
# =====================================================================

# --- Base de datos (obligatoria) --------------------------------------
# Postgres. Si la URL lleva sslmode=disable, la conexión va SIN cifrar
# (solo aceptable si el servidor no tiene TLS y sabes lo que implica).
DATABASE_URL=

# Opcional: la base de producción, solo para medir la retención desde tu
# máquina (npm run medir:retencion -- --produccion). Las migraciones contra
# producción van con DATABASE_URL por un túnel (docs/DESPLIEGUE.md).
DATABASE_URL_PRODUCCION=

# --- Sesiones (obligatorias) ------------------------------------------
# Secreto largo y aleatorio. En Windows PowerShell:
#   [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
# Cambiarlo cierra todas las sesiones abiertas.
AUTH_SECRET=
# La dirección pública, sin barra final. En producción DEBE ser https:
# de ahí sale la marca de cookie segura.
AUTH_URL=http://localhost:3000

# --- Gemini (obligatoria) ---------------------------------------------
# aistudio.google.com > Get API key. Ponle límite de gasto mensual.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Voz de Allison (recomendada) -------------------------------------
# API de texto a voz de Praxis: https://tts-api.praxisia.org/docs. Con
# la clave, Allison habla con su voz propia, generada en streaming; sin
# ella, la app usa la voz del navegador del alumno y lo deja dicho en la
# consola. Pide una clave PROPIA para Allison (cada clave tiene nombre y
# presupuesto por minuto); nunca reutilices otra ni la pongas en código
# que llegue al navegador: solo la lee el servidor.
TTS_API_KEY=
# Opcionales: la dirección de la API y las voces (ids de GET /v1/voices).
# TTS_VOZ lee el inglés y las respuestas mixtas (inglés + [es] español)
# con UNA sola voz; TTS_VOZ_ES, los textos solo en español (bienvenida,
# glosario). Pon la misma en las dos para una única voz de marca.
TTS_URL=https://tts-api.praxisia.org
TTS_VOZ=af_heart
TTS_VOZ_ES=ef_dora
# Síntesis que la app le pide a la API a la vez (el servicio admite DOS
# en total para todos sus clientes) y cuánto espera un turno antes de
# caer a la voz del navegador.
TTS_SIMULTANEAS=2
TTS_ESPERA_TURNO_MS=15000

# --- Correo (obligatorio) ---------------------------------------------
# consola = lo imprime en la terminal (solo desarrollo)
# gmail   = lo envía por SMTP con contraseña de aplicación
# resend  = lo envía por la API de Resend (necesita dominio propio)
# En producción, 'consola' revienta a propósito.
CORREO=consola

# Para CORREO=gmail — la contraseña de APLICACIÓN, no la normal:
# myaccount.google.com > Seguridad > Contraseñas de aplicaciones
GMAIL_USUARIO=
GMAIL_APP_PASSWORD=
# Puerto de salida hacia smtp.gmail.com. Déjalo en 587 (STARTTLS): es el
# que Hetzner NO bloquea. En las cuentas nuevas cierra el 25 y el 465
# hasta que pides el desbloqueo, y con 465 el correo "se queda pensando"
# y nunca sale. Comprueba desde producción con /api/salud?correo=1.
GMAIL_PUERTO=587

# Para CORREO=resend (solo con dominio verificado):
RESEND_API_KEY=
CORREO_REMITENTE=

# --- Pagos (obligatorio) ----------------------------------------------
# simulada = aprueba sin dinero real (solo desarrollo; revienta en
# producción) · bold = cobros de verdad · wompi = la alternativa, que
# solo desembolsa a cuentas Bancolombia o Nequi
PASARELA=simulada

# Solo para la simulada: firma sus avisos de prueba.
PASARELA_SECRETO=

# Para PASARELA=bold. Son las llaves de BOTÓN DE PAGOS (Bold >
# Integraciones > Llaves de integración): la API de links usa esas.
# LAS DOS: con la de identidad sola se crearía el link y el alumno
# pagaría, pero su aviso se rechazaría por firma. Por eso la app se
# niega a cobrar si falta cualquiera.
BOLD_LLAVE_IDENTIDAD=
BOLD_LLAVE_SECRETA=
# true SOLO con las llaves de PRUEBAS y fuera de producción: Bold firma
# esos avisos con una llave vacía. En producción la app se niega a
# cobrar con esto encendido: un pago de prueba acreditaría saldo real.
BOLD_PRUEBAS=
# Opcional: limitar los medios del checkout, separados por coma. Vacío =
# todos los activos en la cuenta, incluido el QR Bre-B (el más barato).
# Nombres exactos: npm run bold:medios. Un nombre inválido hace que la
# app se niegue a cobrar, en vez de ofrecer todos los medios sin avisar.
BOLD_MEDIOS=

# Para PASARELA=wompi. LAS TRES O NINGUNA: sin la de eventos, la app se
# niega a abrir cobros (Wompi cobraría y su aviso se rechazaría).
# Wompi > Desarrolladores. (La llave PRIVADA no se usa: el checkout
# alojado no la pide.)
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# --- Tarea de limpieza diaria -----------------------------------------
# Borra conversaciones de más de 20 días, enlaces vencidos y órdenes
# abandonadas, y concilia los pagos cuyo aviso no llegó. La ruta acepta
# cualquiera de los dos secretos.
#   TAREAS_SECRETO  el que usa la tarea programada de Dokploy
#   CRON_SECRET     opcional, un segundo secreto (n8n, u otra máquina)
CRON_SECRET=
TAREAS_SECRETO=

# --- Detrás de un proxy -----------------------------------------------
# cloudflare | reverso | (vacío si no hay proxy delante)
# Vacío detrás de un proxy = TODOS los usuarios comparten un mismo cubo
# de límite, y un solo abusador deja sin registrarse al resto.
PROXY_CONFIABLE=

# --- Reglas de negocio ------------------------------------------------
COP_POR_MENSAJE=60
RECARGA_MINIMA_COP=8000
# La prueba gratis, completa al crear la cuenta (ya no se parte).
MENSAJES_PRUEBA=5
REGISTROS_GLOBALES_POR_HORA=60

# --- Solo para el script de siembra de colegios -----------------------
MENSAJES_PRUEBA_GRATIS=5

# --- Entrar con Google (opcional) -------------------------------------
# Con las DOS llaves aparece "Entrar con Google" en /entrar y "Continuar
# con Google" en /registro; sin ellas el botón no existe y nada falla.
# El consentimiento legal se sigue pidiendo: quien crea la cuenta con
# Google marca las casillas en /registro, y sin eso la cuenta no se crea.
#
# Cómo obtenerlas (console.cloud.google.com, un proyecto cualquiera):
#   1. APIs y servicios > Pantalla de consentimiento OAuth: tipo Externo,
#      nombre "Allison", correo de soporte, dominio autorizado (el tuyo),
#      enlaces a https://TU-DOMINIO/legal/privacidad y /legal/terminos.
#      Publícala (estado "En producción"): solo se piden openid, email y
#      profile, que Google no obliga a verificar.
#   2. Credenciales > Crear credencial > ID de cliente de OAuth >
#      Aplicación web. Origen autorizado: https://TU-DOMINIO. URI de
#      redirección, EXACTA: https://TU-DOMINIO/api/auth/callback/google
#      (para desarrollo agrega http://localhost:3000/api/auth/callback/google).
#   3. Copia el ID de cliente y el secreto aquí. AUTH_URL tiene que ser
#      el mismo dominio de esa URI, o Google responde redirect_uri_mismatch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Avisos en el celular (recordatorio de la racha) --------------------
# Las notificaciones de la app instalada (Web Push). Sin estas dos llaves
# los avisos quedan apagados y el recordatorio sigue por correo. Se
# generan UNA vez y no se cambian (si cambian, los celulares tienen que
# volver a activar los avisos):
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Contenido en preparación (solo desarrollo) -----------------------
# RUTA_A2=1 muestra a los alumnos de A2 la ruta nueva del Reino Unido con
# lo que ya está pasado a datos (src/lib/ruta/a2). Vacía en producción
# hasta que A2 esté completo y revisado: mientras, A2 usa la ruta
# provisional.
RUTA_A2=
# RUTA_B1=1 hace lo mismo con B1 (Canadá, src/lib/ruta/b1): vacía en
# producción hasta que B1 esté revisado y probado.
RUTA_B1=

# =====================================================================
#  Variables que YA NO existen (si las ves en algún sitio, bórralas:
#  ningún archivo las lee y solo estorban):
#
#  AUDIO_MAX_SEGUNDOS ............ es una constante del código
#  DIAS_RETENCION_CONVERSACIONES . el plazo vive en la base
#  AVISO_MENSAJES_RESTANTES ...... nunca se implementó
#  REDIS_URL ..................... no hay Redis
#  R2_* (cinco) .................. no se guardan audios
#  WOMPI_PRIVATE_KEY ............. el checkout alojado no la pide
#  MENSAJES_PRUEBA_INICIAL ....... la prueba ya no se parte: MENSAJES_PRUEBA
#  MENSAJES_PRUEBA_VERIFICAR ..... (si siguen puestas se suman, pero bórralas)
# =====================================================================
